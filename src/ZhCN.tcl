    lappend zhPatterns [list "^The Capture 17\\.2 PDF package is incomplete: (.*)\\.\$" "Capture 17.2 PDF \u7ec4\u4ef6\u4e0d\u5b8c\u6574\uff1a{0}\u3002"]
