    lappend zhPatterns [list "^Printer '(.*)' did not produce PostScript\\. Choose a PostScript printer\\. Details: (.*)\$" "\u6253\u5370\u673a\u201c{0}\u201d\u672a\u751f\u6210 PostScript\uff0c\u8bf7\u9009\u62e9 PostScript \u6253\u5370\u673a\u3002\u8be6\u7ec6\u65e5\u5fd7\uff1a{1}"]
    lappend zhPatterns [list "^Inconsistent BOM properties across units of (.*)\\.\$" "\u5668\u4ef6 {0} \u7684\u4e0d\u540c\u5355\u5143 BOM \u5c5e\u6027\u4e0d\u4e00\u81f4\u3002"]
