    lappend zhPatterns [list "^Could not read the part color for (.*)\\. No filtered BOM was committed\\.\$" "\u65e0\u6cd5\u8bfb\u53d6\u5668\u4ef6 {0} \u7684\u989c\u8272\uff0c\u672a\u63d0\u4ea4\u7b5b\u9009\u540e\u7684 BOM\u3002"]
    lappend zhPatterns [list "^(.*) exceeded (\[0-9\]+) seconds\\. Export stopped\\.\$" "{0} \u8fd0\u884c\u8d85\u8fc7 {1} \u79d2\uff0c\u5df2\u505c\u6b62\u5bfc\u51fa\u3002"]
    lappend zhPatterns [list "^(.*) failed \\((.*)\\)\\. See the diagnostic log\\.\$" "{0} \u8fd0\u884c\u5931\u8d25\uff08{1}\uff09\uff0c\u8bf7\u67e5\u770b\u8bca\u65ad\u65e5\u5fd7\u3002"]
    lappend zhPatterns [list "^Unsupported PST character: (.*)\$" "\u4e0d\u652f\u6301\u7684 PST \u5b57\u7b26\uff1a{0}"]
    lappend zhPatterns [list "^Could not decode (.*)\\. Check the system locale and schematic text\\.\$" "\u65e0\u6cd5\u89e3\u7801 {0}\uff0c\u8bf7\u68c0\u67e5\u7cfb\u7edf\u533a\u57df\u8bbe\u7f6e\u548c\u539f\u7406\u56fe\u6587\u672c\u3002"]
    lappend zhPatterns [list "^Cadence did not produce (.*)\\. See the diagnostic log\\.\$" "Cadence \u672a\u751f\u6210 {0}\uff0c\u8bf7\u67e5\u770b\u8bca\u65ad\u65e5\u5fd7\u3002"]
    lappend zhPatterns [list "^Incorrect FILE_TYPE in (.*)\\.\$" "{0} \u7684 FILE_TYPE \u7c7b\u578b\u9519\u8bef\u3002"]
    lappend zhPatterns [list "^Incomplete (.*): missing END\\.\$" "{0} \u4e0d\u5b8c\u6574\uff1a\u7f3a\u5c11 END\u3002"]
    lappend zhPatterns [list "^Duplicate primitive definition: (.*)\$" "\u5668\u4ef6\u539f\u8bed\u5b9a\u4e49\u91cd\u590d\uff1a{0}"]
    lappend zhPatterns [list "^Unterminated primitive definition: (.*)\$" "\u5668\u4ef6\u539f\u8bed\u5b9a\u4e49\u672a\u7ed3\u675f\uff1a{0}"]
    lappend zhPatterns [list "^Primitive definition has no body: (.*)\$" "\u5668\u4ef6\u539f\u8bed\u5b9a\u4e49\u7f3a\u5c11\u4e3b\u4f53\uff1a{0}"]
    lappend zhPatterns [list "^Duplicate reference: (.*)\$" "\u4f4d\u53f7\u91cd\u590d\uff1a{0}"]
    lappend zhPatterns [list "^Duplicate net name: (.*)\$" "\u7f51\u7edc\u540d\u79f0\u91cd\u590d\uff1a{0}"]
    lappend zhPatterns [list "^Net (.*) references unknown component (.*)\\.\$" "\u7f51\u7edc {0} \u5f15\u7528\u4e86\u672a\u77e5\u5668\u4ef6 {1}\u3002"]
    lappend zhPatterns [list "^Pin (.*) appears on both (.*) and (.*)\\.\$" "\u5f15\u811a {0} \u540c\u65f6\u51fa\u73b0\u5728\u7f51\u7edc {1} \u548c {2} \u4e0a\u3002"]
    lappend zhPatterns [list "^(.*) references missing primitive (.*)\\.\$" "\u5668\u4ef6 {0} \u5f15\u7528\u4e86\u7f3a\u5931\u7684\u539f\u8bed {1}\u3002"]
    lappend zhPatterns [list "^Missing PCB Footprint for (.*)\\. Fix the schematic\\.\$" "\u5668\u4ef6 {0} \u7f3a\u5c11 PCB \u5c01\u88c5\uff0c\u8bf7\u4fee\u6b63\u539f\u7406\u56fe\u3002"]
    lappend zhPatterns [list "^Invalid PADS 2000/V3 (.*): (.*)\\. Fix the schematic; names are never silently changed\\.\$" "PADS 2000/V3 \u7684 {0} \u4e0d\u5408\u6cd5\uff1a{1}\u3002\u8bf7\u4fee\u6b63\u539f\u7406\u56fe\uff0c\u63d2\u4ef6\u4e0d\u4f1a\u9759\u9ed8\u4fee\u6539\u540d\u79f0\u3002"]
    lappend zhPatterns [list "^Unsupported power pin syntax: (.*)\$" "\u4e0d\u652f\u6301\u7684\u7535\u6e90\u5f15\u811a\u8bed\u6cd5\uff1a{0}"]
    lappend zhPatterns [list "^Check the power pin mapping: (.*)\$" "\u8bf7\u68c0\u67e5\u7535\u6e90\u5f15\u811a\u6620\u5c04\uff1a{0}"]
    lappend zhPatterns [list "^Conflicting implicit power nets for (.*)\\.\$" "\u5f15\u811a {0} \u7684\u9690\u5f0f\u7535\u6e90\u7f51\u7edc\u51b2\u7a81\u3002"]
    lappend zhPatterns [list "^(.*) has POWER_GROUP and unexpanded (.*); power connectivity cannot be inferred\\.\$" "\u5668\u4ef6 {0} \u5b58\u5728 POWER_GROUP \u4e14\u5f15\u811a {1} \u672a\u5c55\u5f00\uff0c\u65e0\u6cd5\u63a8\u65ad\u7535\u6e90\u8fde\u63a5\u3002"]
    lappend zhPatterns [list "^References differ only in case and conflict in PADS: (.*)\$" "\u4f4d\u53f7\u4ec5\u5927\u5c0f\u5199\u4e0d\u540c\uff0c\u5728 PADS \u4e2d\u51b2\u7a81\uff1a{0}"]
    lappend zhPatterns [list "^Net names differ only in case and conflict in PADS: (.*)\$" "\u7f51\u7edc\u540d\u79f0\u4ec5\u5927\u5c0f\u5199\u4e0d\u540c\uff0c\u5728 PADS \u4e2d\u51b2\u7a81\uff1a{0}"]
    lappend zhPatterns [list "^The export worker stopped unexpectedly: (.*)\$" "\u5bfc\u51fa\u7a0b\u5e8f\u610f\u5916\u505c\u6b62\uff1a{0}"]
}
